)

print(
    features[
        "activity_level"
    ]
    .value_counts()
)


print()
print(
    "Slow-moving Store-SKU:",
    features[
        "slow_moving"
    ].sum()
)


print(
    "High-demand Store-SKU:",
    features[
        "high_demand"
    ].sum()
)


print(
    "Dormant Store-SKU:",
    features[
        "dormant_90d"
    ].sum()
)


# ============================================================
# FINAL
# ============================================================

print()
print("=" * 70)
print("PHASE 6.3 COMPLETED")
print("=" * 70)